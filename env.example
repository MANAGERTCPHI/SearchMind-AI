# ==========================================
# SearchMind AI Environment Configuration
# ==========================================
# Copy this file to .env.local and replace
# the placeholder values with your credentials.
# ==========================================


# ------------------------------------------
# Application
# ------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=SearchMind AI


# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Get these from:
# Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# ------------------------------------------
# Authentication
# ------------------------------------------

NEXTAUTH_SECRET=generate_a_secure_random_secret

AUTH_GOOGLE_ID=

AUTH_GOOGLE_SECRET=


# ------------------------------------------
# Database
# ------------------------------------------

DATABASE_URL=postgresql://username:password@host:5432/database


# ------------------------------------------
# AI Provider
# ------------------------------------------
# Reserved for AI keyword research engine

OPENAI_API_KEY=


# ------------------------------------------
# Analytics
# ------------------------------------------

NEXT_PUBLIC_VERCEL_ANALYTICS_ID=


# ------------------------------------------
# Email Provider
# ------------------------------------------
# Optional: transactional emails

RESEND_API_KEY=


# ------------------------------------------
# Security
# ------------------------------------------

CRON_SECRET=

API_RATE_LIMIT_SECRET=


# ------------------------------------------
# Feature Flags
# ------------------------------------------

NEXT_PUBLIC_ENABLE_AI_FEATURES=true

NEXT_PUBLIC_ENABLE_ANALYTICS=true
